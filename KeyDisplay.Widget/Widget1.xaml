<Page
    x:Class="KeyDisplay.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 0.9.4 字体：页面级 FontFamily 继承给所有子元素——Windows 11 官方 UI 字体
             Segoe UI Variable（与「设置」「资源管理器」同款）；Win10 旧环境回退 Segoe UI，
             中文由系统回退到「微软雅黑 UI」，视觉风格一致。 -->
        <Style x:Key="KeyBorder" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootPanel" CornerRadius="14" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0.9.4：Row0 可伸缩，内容高度跟随窗口；键区超出部分由代码整体等比缩放补偿（FitLayoutToWindow）。 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 键区（0.7.1）：Canvas 自由布局——按键尺寸/位置不再参与流式布局，缩放拉长不会推挤任何兄弟元素；
                     Row0 可伸缩；键区整体缩放由代码按窗口可视区自动计算（窗口变小则等比缩小，保持完整可见） -->
                <Canvas x:Name="KeyLayer" Grid.Row="0">
                    <!-- 键盘列（键距 6、行距 8 已折算进坐标，与原流式布局视觉一致） -->
                    <Border x:Name="KeyQ" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="0">
                        <TextBlock x:Name="KeyQText" Style="{StaticResource KeyText}" Text="Q"/>
                    </Border>
                    <Border x:Name="KeyW" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="58" Canvas.Top="0">
                        <TextBlock x:Name="KeyWText" Style="{StaticResource KeyText}" Text="W"/>
                    </Border>
                    <Border x:Name="KeyE" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="116" Canvas.Top="0">
                        <TextBlock x:Name="KeyEText" Style="{StaticResource KeyText}" Text="E"/>
                    </Border>
                    <Border x:Name="KeyR" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="174" Canvas.Top="0">
                        <TextBlock x:Name="KeyRText" Style="{StaticResource KeyText}" Text="R"/>
                    </Border>
                    <Border x:Name="KeyA" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="56">
                        <TextBlock x:Name="KeyAText" Style="{StaticResource KeyText}" Text="A"/>
                    </Border>
                    <Border x:Name="KeyS" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="58" Canvas.Top="56">
                        <TextBlock x:Name="KeySText" Style="{StaticResource KeyText}" Text="S"/>
                    </Border>
                    <Border x:Name="KeyD" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="116" Canvas.Top="56">
                        <TextBlock x:Name="KeyDText" Style="{StaticResource KeyText}" Text="D"/>
                    </Border>
                    <Border x:Name="KeyF" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="174" Canvas.Top="56">
                        <TextBlock x:Name="KeyFText" Style="{StaticResource KeyText}" Text="F"/>
                    </Border>
                    <Border x:Name="KeyShift" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="112">
                        <TextBlock x:Name="KeyShiftText" Style="{StaticResource KeyText}" FontSize="13" Text="左Shift"/>
                    </Border>
                    <Border x:Name="KeyCtrl" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="74" Canvas.Top="112">
                        <TextBlock x:Name="KeyCtrlText" Style="{StaticResource KeyText}" FontSize="13" Text="左Ctrl"/>
                    </Border>
                    <Border x:Name="KeyAlt" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="148" Canvas.Top="112">
                        <TextBlock x:Name="KeyAltText" Style="{StaticResource KeyText}" FontSize="13" Text="左Alt"/>
                    </Border>
                    <!-- 第四行 空格（标准键盘式底部空格） -->
                    <Border x:Name="KeySpace" Width="176" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="168">
                        <TextBlock x:Name="KeySpaceText" Style="{StaticResource KeyText}" FontSize="13" Text="空格"/>
                    </Border>
                    <!-- 鼠标区（X 起点 = 键盘列右缘 226 + 16 间距） -->
                    <Border x:Name="MousePad" Width="80" Height="80" CornerRadius="8" BorderThickness="1" Tag="Pad" Canvas.Left="242" Canvas.Top="0">
                        <Canvas x:Name="MousePadCanvas">
                            <Ellipse x:Name="MouseDot" Width="10" Height="10"/>
                        </Canvas>
                    </Border>
                    <!-- 滚轮键（0.7.0）：鼠标垫右侧，滚轮上/滚轮下（companion 经 VK 0x07/0x08 点亮 150ms） -->
                    <Border x:Name="MouseWheelUp" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="328" Canvas.Top="0">
                        <TextBlock x:Name="MouseWheelUpText" Style="{StaticResource KeyText}" FontSize="10" Text="滚轮上" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="MouseWheelDown" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="328" Canvas.Top="42">
                        <TextBlock x:Name="MouseWheelDownText" Style="{StaticResource KeyText}" FontSize="10" Text="滚轮下" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="MouseL" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="242" Canvas.Top="88">
                        <TextBlock x:Name="MouseLText" Style="{StaticResource KeyText}" FontSize="12" Text="左键"/>
                    </Border>
                    <Border x:Name="MouseM" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="284" Canvas.Top="88">
                        <TextBlock x:Name="MouseMText" Style="{StaticResource KeyText}" FontSize="12" Text="中键"/>
                    </Border>
                    <Border x:Name="MouseR" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="326" Canvas.Top="88">
                        <TextBlock x:Name="MouseRText" Style="{StaticResource KeyText}" FontSize="12" Text="右键"/>
                    </Border>
                    <Border x:Name="MouseX1" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="242" Canvas.Top="132">
                        <TextBlock x:Name="MouseX1Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧下"/>
                    </Border>
                    <Border x:Name="MouseX2" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="284" Canvas.Top="132">
                        <TextBlock x:Name="MouseX2Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧上"/>
                    </Border>
                    <!-- 自定义按键区：由"自定义控件"菜单从 87 配列布局添加的按键（动态创建、按名去重、持久化恢复；
                         Canvas 内相对 (0,224) 定位，实际位置 = (224 行) + 位置 transform） -->
                    <Canvas x:Name="CustomKeysPanel" Canvas.Left="0" Canvas.Top="224" Visibility="Collapsed"/>
                    <!-- ===== 手柄组（1.2）=====
                         几何/字形/配色全部照 tools\pad_preview.py 的 PadPanel：原点 = 本 Canvas 左上角，
                         单位 = 设计单位，整组约 168×104，摆在默认键位与鼠标垫都不占用的空位 (208,160)。
                         放在 KeyLayer 内 → 自动继承键区的整体缩放（FitLayoutToWindow，含「整体按键大小」滑条）。
                         默认 Collapsed：GamepadMode_=1（自动）且未检测到已连接手柄时整组不显示，
                         现有键鼠界面一个像素都不变；显隐与按下态由 Widget1.xaml.cs 的 ApplyGamepadState 每帧决定。
                         圆角/描边与既有按键一致（角上的半径按预览：肩键/View/Menu 用 6，十字键 3，扳机条 4）。 -->
                    <Canvas x:Name="GamepadPanel" Visibility="Collapsed" Canvas.Left="208" Canvas.Top="160">
                        <!-- 1.4：手柄轮廓模板层（组合模式才有；custom 模式整块 Collapsed）。
                             必须是 GamepadPanel 的第一个子元素 → 渲染在最底层，位于所有部件之下；
                             IsHitTestVisible=False → 不拦截指针，拖拽/缩放/吸附/右键菜单完全不受影响。
                             轮廓元素由代码按键位风格（Xbox / PlayStation / Switch）建立为纯描边图形
                             （Stroke=BorderB()、StrokeThickness=1、Fill=透明），坐标与部件同一套设计单位。 -->
                        <Canvas x:Name="GamepadTemplatePanel" IsHitTestVisible="False"/>
                        <!-- 电量角标：文字中心 (84,14)（与预览同锚点），按等级显示「电量 低/中/满」 -->
                        <TextBlock x:Name="GpBattery" Visibility="Collapsed" Text="" FontSize="9" TextAlignment="Center" Width="100"
                                   Canvas.Left="34" Canvas.Top="8"/>
        <!-- 电量条：底槽 + 按电量比例填充（取代原来的文字与中间的圆球） -->
        <Border x:Name="GpBatTrack" Canvas.Left="61" Canvas.Top="34" Width="46" Height="10" CornerRadius="5" BorderThickness="1">
            <Border x:Name="GpBatFill" Width="0" Height="6" CornerRadius="3" HorizontalAlignment="Left" Margin="1,0,0,0"/>
        </Border>
                        <!-- 肩键 LB/RB（26×14）：字随风格变（Xbox LB/RB、PS L1/R1、Switch L/R） -->
                        <Border x:Name="GpLB" Width="26" Height="14" CornerRadius="6" BorderThickness="1" Canvas.Left="24" Canvas.Top="8">
                            <TextBlock x:Name="GpLBText" Style="{StaticResource KeyText}" FontSize="9" Text="LB"/>
                        </Border>
                        <Border x:Name="GpRB" Width="26" Height="14" CornerRadius="6" BorderThickness="1" Canvas.Left="118" Canvas.Top="8">
                            <TextBlock x:Name="GpRBText" Style="{StaticResource KeyText}" FontSize="9" Text="RB"/>
                        </Border>
                        <!-- 扳机 LT/RT（12×30 竖向圆角条）：外框 + 内部填充矩形 GpLTFill/GpRTFill（从底向上长）；
                             文字在条的正上方居中（与预览同锚点），value 模式下追加百分比 -->
                        <Border x:Name="GpLT" Width="12" Height="22" CornerRadius="4" BorderThickness="1" Canvas.Left="6" Canvas.Top="2">
                            <Rectangle x:Name="GpLTFill" Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                        </Border>
                        <Border x:Name="GpRT" Width="12" Height="22" CornerRadius="4" BorderThickness="1" Canvas.Left="150" Canvas.Top="2">
                            <Rectangle x:Name="GpRTFill" Height="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                        </Border>
                        <TextBlock x:Name="GpLTText" Visibility="Collapsed" Text="LT" FontSize="8" TextAlignment="Center" Width="46" Canvas.Left="-11" Canvas.Top="-9"/>
                        <TextBlock x:Name="GpRTText" Visibility="Collapsed" Text="RT" FontSize="8" TextAlignment="Center" Width="46" Canvas.Left="133" Canvas.Top="-9"/>
                        <!-- ABXY 菱形：物理位置固定（下/右/左/上，中心 (126,48) 偏移 ±13，φ18），只换圆心内的字 -->
                        <Border x:Name="GpFaceTop" Width="18" Height="18" CornerRadius="9" BorderThickness="1" Canvas.Left="135" Canvas.Top="29">
                            <TextBlock x:Name="GpFaceTopText" Style="{StaticResource KeyText}" FontSize="10" Text="Y"/>
                        </Border>
                        <Border x:Name="GpFaceLeft" Width="18" Height="18" CornerRadius="9" BorderThickness="1" Canvas.Left="122" Canvas.Top="42">
                            <TextBlock x:Name="GpFaceLeftText" Style="{StaticResource KeyText}" FontSize="10" Text="X"/>
                        </Border>
                        <Border x:Name="GpFaceRight" Width="18" Height="18" CornerRadius="9" BorderThickness="1" Canvas.Left="148" Canvas.Top="42">
                            <TextBlock x:Name="GpFaceRightText" Style="{StaticResource KeyText}" FontSize="10" Text="B"/>
                        </Border>
                        <Border x:Name="GpFaceBottom" Width="18" Height="18" CornerRadius="9" BorderThickness="1" Canvas.Left="135" Canvas.Top="55">
                            <TextBlock x:Name="GpFaceBottomText" Style="{StaticResource KeyText}" FontSize="10" Text="A"/>
                        </Border>
                        <!-- 十字键（12×12 圆角块，中心 (34,84) 偏移 ±13） -->
                        <Border x:Name="GpDpadUp" Width="12" Height="12" CornerRadius="3" BorderThickness="1" Canvas.Left="47" Canvas.Top="63"/>
                        <Border x:Name="GpDpadDown" Width="12" Height="12" CornerRadius="3" BorderThickness="1" Canvas.Left="47" Canvas.Top="89"/>
                        <Border x:Name="GpDpadLeft" Width="12" Height="12" CornerRadius="3" BorderThickness="1" Canvas.Left="34" Canvas.Top="76"/>
                        <Border x:Name="GpDpadRight" Width="12" Height="12" CornerRadius="3" BorderThickness="1" Canvas.Left="60" Canvas.Top="76"/>
                        <!-- 左摇杆（环 φ30 中心 (34,44) + 点 φ10）与 L3 标签（环外侧，避免压到十字键） -->
                        <Ellipse x:Name="GpLsRing" Width="30" Height="30" StrokeThickness="1" Canvas.Left="12" Canvas.Top="31"/>
                        <Ellipse x:Name="GpLsDot" Width="10" Height="10" Canvas.Left="22" Canvas.Top="41"/>
                        <TextBlock x:Name="GpLsHint" Visibility="Collapsed" Text="L3" FontSize="8" TextAlignment="Center" Width="16" Canvas.Left="-11" Canvas.Top="41"/>
                        <!-- 右摇杆（环 φ30 中心 (126,88) + 点 φ10）与 R3 标签 -->
                        <Ellipse x:Name="GpRsRing" Width="30" Height="30" StrokeThickness="1" Canvas.Left="103" Canvas.Top="71"/>
                        <Ellipse x:Name="GpRsDot" Width="10" Height="10" Canvas.Left="113" Canvas.Top="81"/>
                        <TextBlock x:Name="GpRsHint" Visibility="Collapsed" Text="R3" FontSize="8" TextAlignment="Center" Width="16" Canvas.Left="142" Canvas.Top="81"/>
                        <!-- View / Menu（18×13 圆角块，宽度 18 是给十字键右侧留间隙） -->
                        <Border x:Name="GpView" Width="18" Height="13" CornerRadius="6" BorderThickness="1" Canvas.Left="55" Canvas.Top="30">
                            <TextBlock x:Name="GpViewText" Style="{StaticResource KeyText}" FontSize="7" Text="View"/>
                        </Border>
                        <Border x:Name="GpMenu" Width="18" Height="13" CornerRadius="6" BorderThickness="1" Canvas.Left="98" Canvas.Top="31">
                            <TextBlock x:Name="GpMenuText" Style="{StaticResource KeyText}" FontSize="7" Text="Menu"/>
                        </Border>
                        <!-- Guide（φ22 圆环，中心 (84,56)）：按下时圆环换按下底色 -->
                        <Ellipse x:Name="GpGuide" Visibility="Collapsed" Width="22" Height="22" StrokeThickness="1" Canvas.Left="73" Canvas.Top="28"/>
                    </Canvas>
                </Canvas>
                <TextBlock x:Name="StatusText" Text="" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Opacity="0.6"/>
                <!-- 按键右键菜单覆盖层：右键按键弹出（删除/复制/修改显示名）；点遮罩关闭 -->
                <Grid x:Name="KeyMenuPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Tapped="KeyMenuPanel_Tapped">
                    <Border x:Name="KeyMenu" Width="208" CornerRadius="8" BorderThickness="1" Padding="4" Tapped="KeyMenu_Tapped">
                        <StackPanel x:Name="KeyMenuItems"/>
                    </Border>
                </Grid>
                <!-- 修改显示名覆盖层：右键菜单「修改显示名」弹出；确定/取消/点遮罩关闭 -->
                <Grid x:Name="RenamePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Tapped="RenamePanel_Tapped">
                    <Border x:Name="RenameBox" Width="220" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="KeyMenu_Tapped">
                        <StackPanel Padding="14">
                            <TextBlock x:Name="RenameTitle" Text="修改显示名" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBox x:Name="RenameInput" FontSize="13" Margin="0,12,0,0" MaxLength="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Border x:Name="RenameConfirm" Width="64" Height="26" CornerRadius="6" BorderThickness="1" Tapped="RenameConfirm_Click">
                                    <TextBlock x:Name="RenameConfirmText" Text="确定" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="RenameCancel" Width="64" Height="26" CornerRadius="6" BorderThickness="1" Margin="12,0,0,0" Tapped="RenameCancel_Click">
                                    <TextBlock x:Name="RenameCancelText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 删除确认框覆盖层：右键自定义键弹出；确认/取消/点遮罩关闭 -->
                <Grid x:Name="DeleteConfirmPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="DeleteConfirmPanel_Tapped">
                    <Border x:Name="DeleteConfirmBox" Width="210" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="LockMenu_Tapped">
                        <StackPanel Padding="14">
                            <TextBlock x:Name="DeleteConfirmText" Text="" FontSize="13" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Border x:Name="DeleteConfirmYes" Width="64" Height="26" CornerRadius="6" BorderThickness="1"
                                        Tapped="DeleteConfirmYes_Click">
                                    <TextBlock x:Name="DeleteConfirmYesText" Text="确认" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="DeleteConfirmNo" Width="64" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="12,0,0,0" Tapped="DeleteConfirmNo_Click">
                                    <TextBlock x:Name="DeleteConfirmNoText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- 吸附参考线层：吸附发生时显示浅蓝虚线；置于所有按键之上、不拦截指针，不参与吸附计算 -->
        <Canvas x:Name="SnapCanvas" IsHitTestVisible="False"/>
    </Grid>
</Page>
