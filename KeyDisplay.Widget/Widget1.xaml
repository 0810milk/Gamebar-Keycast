<Page
    x:Class="KeyDisplay.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="KeyBorder" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootPanel" CornerRadius="10" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="272"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <!-- 键区（0.7.1）：Canvas 自由布局——按键尺寸/位置不再参与流式布局，缩放拉长不会推挤任何兄弟元素；
                     宽度自适应内容（窗口随内容或固定均可），Row0 固定 272 = 设置行上方，
                     缩放上限由代码按窗口可视边界钳制（撞边 = 窗口边框，非看不见的墙），设置行（Row1）永不被推出 -->
                <Canvas x:Name="KeyLayer" Grid.Row="0">
                    <!-- 键盘列（键距 6、行距 8 已折算进坐标，与原流式布局视觉一致） -->
                    <Border x:Name="KeyQ" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="0">
                        <TextBlock x:Name="KeyQText" Style="{StaticResource KeyText}" Text="Q"/>
                    </Border>
                    <Border x:Name="KeyW" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="58" Canvas.Top="0">
                        <TextBlock x:Name="KeyWText" Style="{StaticResource KeyText}" Text="W"/>
                    </Border>
                    <Border x:Name="KeyE" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="116" Canvas.Top="0">
                        <TextBlock x:Name="KeyEText" Style="{StaticResource KeyText}" Text="E"/>
                    </Border>
                    <Border x:Name="KeyR" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="174" Canvas.Top="0">
                        <TextBlock x:Name="KeyRText" Style="{StaticResource KeyText}" Text="R"/>
                    </Border>
                    <Border x:Name="KeyA" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="56">
                        <TextBlock x:Name="KeyAText" Style="{StaticResource KeyText}" Text="A"/>
                    </Border>
                    <Border x:Name="KeyS" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="58" Canvas.Top="56">
                        <TextBlock x:Name="KeySText" Style="{StaticResource KeyText}" Text="S"/>
                    </Border>
                    <Border x:Name="KeyD" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="116" Canvas.Top="56">
                        <TextBlock x:Name="KeyDText" Style="{StaticResource KeyText}" Text="D"/>
                    </Border>
                    <Border x:Name="KeyF" Width="52" Style="{StaticResource KeyBorder}" Canvas.Left="174" Canvas.Top="56">
                        <TextBlock x:Name="KeyFText" Style="{StaticResource KeyText}" Text="F"/>
                    </Border>
                    <Border x:Name="KeyShift" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="112">
                        <TextBlock x:Name="KeyShiftText" Style="{StaticResource KeyText}" FontSize="13" Text="左Shift"/>
                    </Border>
                    <Border x:Name="KeyCtrl" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="74" Canvas.Top="112">
                        <TextBlock x:Name="KeyCtrlText" Style="{StaticResource KeyText}" FontSize="13" Text="左Ctrl"/>
                    </Border>
                    <Border x:Name="KeyAlt" Width="68" Style="{StaticResource KeyBorder}" Canvas.Left="148" Canvas.Top="112">
                        <TextBlock x:Name="KeyAltText" Style="{StaticResource KeyText}" FontSize="13" Text="左Alt"/>
                    </Border>
                    <!-- 第四行 空格（标准键盘式底部空格） -->
                    <Border x:Name="KeySpace" Width="176" Style="{StaticResource KeyBorder}" Canvas.Left="0" Canvas.Top="168">
                        <TextBlock x:Name="KeySpaceText" Style="{StaticResource KeyText}" FontSize="13" Text="空格"/>
                    </Border>
                    <!-- 鼠标区（X 起点 = 键盘列右缘 226 + 16 间距） -->
                    <Border x:Name="MousePad" Width="80" Height="80" CornerRadius="8" BorderThickness="1" Tag="Pad" Canvas.Left="242" Canvas.Top="0">
                        <Canvas x:Name="MousePadCanvas">
                            <Ellipse x:Name="MouseDot" Width="10" Height="10"/>
                        </Canvas>
                    </Border>
                    <!-- 滚轮键（0.7.0）：鼠标垫右侧，滚轮上/滚轮下（companion 经 VK 0x07/0x08 点亮 150ms） -->
                    <Border x:Name="MouseWheelUp" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="328" Canvas.Top="0">
                        <TextBlock x:Name="MouseWheelUpText" Style="{StaticResource KeyText}" FontSize="10" Text="滚轮上" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="MouseWheelDown" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="328" Canvas.Top="42">
                        <TextBlock x:Name="MouseWheelDownText" Style="{StaticResource KeyText}" FontSize="10" Text="滚轮下" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="MouseL" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="242" Canvas.Top="88">
                        <TextBlock x:Name="MouseLText" Style="{StaticResource KeyText}" FontSize="12" Text="左键"/>
                    </Border>
                    <Border x:Name="MouseM" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="284" Canvas.Top="88">
                        <TextBlock x:Name="MouseMText" Style="{StaticResource KeyText}" FontSize="12" Text="中键"/>
                    </Border>
                    <Border x:Name="MouseR" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="326" Canvas.Top="88">
                        <TextBlock x:Name="MouseRText" Style="{StaticResource KeyText}" FontSize="12" Text="右键"/>
                    </Border>
                    <Border x:Name="MouseX1" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="242" Canvas.Top="132">
                        <TextBlock x:Name="MouseX1Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧下"/>
                    </Border>
                    <Border x:Name="MouseX2" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Canvas.Left="284" Canvas.Top="132">
                        <TextBlock x:Name="MouseX2Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧上"/>
                    </Border>
                    <!-- 自定义按键区：由"自定义控件"菜单从 87 配列布局添加的按键（动态创建、按名去重、持久化恢复；
                         Canvas 内相对 (0,224) 定位，实际位置 = (224 行) + 位置 transform） -->
                    <Canvas x:Name="CustomKeysPanel" Canvas.Left="0" Canvas.Top="224" Visibility="Collapsed"/>
                </Canvas>
                <!-- 底部工具条：设置按钮（右对齐，固定不参与移动/锁定） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Border x:Name="SettingsBtn" Width="52" Height="26" CornerRadius="13" BorderThickness="1"
                            Tapped="Settings_Click">
                        <TextBlock x:Name="SettingsBtnText" Text="设置"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Opacity="0.6"/>
                <!-- 设置子菜单覆盖层：点击设置图标展开，点遮罩收起（不用系统 Flyout，避免 Game Bar 宿主崩溃） -->
                <Grid x:Name="SettingsPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="SettingsPanel_Tapped">
                    <Border x:Name="SettingsMenu" Width="190" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,44"
                            Tapped="SettingsMenu_Tapped">
                        <StackPanel Padding="12">
                            <!-- 标题行：左侧「设置」+ 右上角「关于」椭圆按钮 -->
                            <Grid>
                                <TextBlock x:Name="SettingsTitle" Text="设置" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="SettingsInfoBtn" Width="46" Height="22" CornerRadius="11" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Tapped="SettingsInfo_Click">
                                    <TextBlock x:Name="SettingsInfoText" Text="关于" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="SettingsThemeLabel" Text="主题" FontSize="13" VerticalAlignment="Center"/>
                                <Border x:Name="SettingsCustomBtn" Width="52" Height="22" CornerRadius="11"
                                        BorderThickness="1" HorizontalAlignment="Right" Margin="0,0,52,0" Tapped="CustomTheme_Click">
                                    <TextBlock Text="自定义" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                                <Border x:Name="SettingsThemeBtn" Width="44" Height="22" CornerRadius="11"
                                        BorderThickness="1" HorizontalAlignment="Right" Tapped="SettingsTheme_Click">
                                    <TextBlock x:Name="SettingsThemeText" Text="白" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                            </Grid>
                            <!-- 按键透明度滑条：10%~100%，无数值标注，线性；游玩（锁定开启）时生效，编辑（锁定关闭）时按键强制 100% -->
                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="SettingsOpacityLabel" Text="透明度" FontSize="13" VerticalAlignment="Center"/>
                                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100"
                                        Width="108" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_Changed"
                                        PointerCaptureLost="OpacitySlider_DragCompleted"/>
                            </Grid>
                            <!-- 鼠标垫显示/隐藏开关：仅切 Visibility（不删除，位置/尺寸/transform 保留） -->
                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="SettingsPadLabel" Text="鼠标垫" FontSize="13" VerticalAlignment="Center"/>
                                <Border x:Name="SettingsPadBtn" Width="44" Height="22" CornerRadius="11"
                                        BorderThickness="1" HorizontalAlignment="Right" Tapped="PadToggle_Click">
                                    <TextBlock x:Name="SettingsPadText" Text="显示" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                            </Grid>
                            <Border x:Name="LockKeyBtn" Height="26" CornerRadius="6" BorderThickness="1"
                                    Margin="0,12,0,0" Tapped="LockKey_Click">
                                <TextBlock x:Name="LockKeyText" Text="自定义控件" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <!-- 用户预设入口：主题预设 / 布局预设（样式与 LockKeyBtn 一致，并排两列等宽） -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ThemePresetBtn" Grid.Column="0" Height="26" CornerRadius="6" BorderThickness="1"
                                        Tapped="ThemePreset_Click">
                                    <TextBlock x:Name="ThemePresetBtnText" Text="主题预设" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="LayoutPresetBtn" Grid.Column="1" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="8,0,0,0" Tapped="LayoutPreset_Click">
                                    <TextBlock x:Name="LayoutPresetBtnText" Text="布局预设" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 主题预设子菜单覆盖层：设置菜单"主题预设"入口弹出；点遮罩/关闭收起（与 SettingsPanel 同级覆盖层，不嵌套） -->
                <Grid x:Name="ThemePresetPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="ThemePresetPanel_Tapped">
                    <Border x:Name="ThemePresetMenu" Width="260" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,44"
                            Tapped="ThemePresetMenu_Tapped">
                        <StackPanel Padding="12">
                            <!-- 标题行：左侧「主题预设」 -->
                            <Grid>
                                <TextBlock x:Name="ThemePresetTitle" Text="主题预设" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 错误/状态提示：空名/重名/保存失败等，初始隐藏 -->
                            <TextBlock x:Name="ThemePresetMsg" FontSize="11" Foreground="#FFFF5050"
                                       Visibility="Collapsed" Margin="0,8,0,0"/>
                            <!-- 预设列表容器：动态项由 C# 添加 -->
                            <StackPanel x:Name="ThemePresetList" Margin="0,8,0,0"/>
                            <!-- 添加预设 + 导入按钮行：导入（0.7.1）读取用户分享的预设文件 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ThemePresetAddBtn" Grid.Column="0" Height="26" CornerRadius="6" BorderThickness="1"
                                        Tapped="ThemePresetAdd_Click">
                                    <TextBlock x:Name="ThemePresetAddText" Text="添加预设" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="ThemePresetImportBtn" Grid.Column="1" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="8,0,0,0" Padding="14,0,14,0" Tapped="ThemePresetImport_Click">
                                    <TextBlock Text="导入" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                            <!-- 预设名输入行：初始隐藏，点"添加预设"展开 -->
                            <Grid x:Name="ThemePresetNameRow" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ThemePresetNameInput" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="ThemePresetSaveBtn" Grid.Column="1" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="0,0,8,0" Padding="12,0,12,0" Tapped="ThemePresetSave_Click">
                                    <TextBlock x:Name="ThemePresetSaveText" Text="保存" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="ThemePresetCancelBtn" Grid.Column="2" Height="26" CornerRadius="6" BorderThickness="1"
                                        Padding="12,0,12,0" Tapped="ThemePresetCancel_Click">
                                    <TextBlock x:Name="ThemePresetCancelText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 布局预设子菜单覆盖层：设置菜单"布局预设"入口弹出；点遮罩/关闭收起（与 SettingsPanel 同级覆盖层，不嵌套） -->
                <Grid x:Name="LayoutPresetPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="LayoutPresetPanel_Tapped">
                    <Border x:Name="LayoutPresetMenu" Width="260" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,44"
                            Tapped="LayoutPresetMenu_Tapped">
                        <StackPanel Padding="12">
                            <!-- 标题行：左侧「布局预设」 -->
                            <Grid>
                                <TextBlock x:Name="LayoutPresetTitle" Text="布局预设" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 错误/状态提示：空名/重名/保存失败等，初始隐藏 -->
                            <TextBlock x:Name="LayoutPresetMsg" FontSize="11" Foreground="#FFFF5050"
                                       Visibility="Collapsed" Margin="0,8,0,0"/>
                            <!-- 预设列表容器：动态项由 C# 添加 -->
                            <StackPanel x:Name="LayoutPresetList" Margin="0,8,0,0"/>
                            <!-- 添加布局预设 + 导入按钮行：导入（0.7.1）读取用户分享的预设文件 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LayoutPresetAddBtn" Grid.Column="0" Height="26" CornerRadius="6" BorderThickness="1"
                                        Tapped="LayoutPresetAdd_Click">
                                    <TextBlock x:Name="LayoutPresetAddText" Text="添加布局预设" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="LayoutPresetImportBtn" Grid.Column="1" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="8,0,0,0" Padding="14,0,14,0" Tapped="LayoutPresetImport_Click">
                                    <TextBlock Text="导入" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                            <!-- 预设名输入行：初始隐藏，点"添加布局预设"展开 -->
                            <Grid x:Name="LayoutPresetNameRow" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LayoutPresetNameInput" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="LayoutPresetSaveBtn" Grid.Column="1" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="0,0,8,0" Padding="12,0,12,0" Tapped="LayoutPresetSave_Click">
                                    <TextBlock x:Name="LayoutPresetSaveText" Text="保存" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="LayoutPresetCancelBtn" Grid.Column="2" Height="26" CornerRadius="6" BorderThickness="1"
                                        Padding="12,0,12,0" Tapped="LayoutPresetCancel_Click">
                                    <TextBlock x:Name="LayoutPresetCancelText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 主题颜色子菜单覆盖层：设置菜单"自定义"按钮弹出；点遮罩收起（8 个调色目标 + 独立调色盘子菜单） -->
                <Grid x:Name="ThemeColorPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="ThemeColorPanel_Tapped">
                    <!-- 双栏容器：列0=调色盘、列1=主题颜色；整体右下对齐，由布局引擎保证两子菜单并排、永不重叠 -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <Border x:Name="ThemeColorMenu" Grid.Column="1" Width="320" CornerRadius="8" BorderThickness="1"
                            Margin="8,0,0,0"
                            Tapped="ThemeColorMenu_Tapped">
                        <ScrollViewer x:Name="ThemeColorScroll" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <StackPanel Padding="12">
                            <TextBlock x:Name="ThemeColorTitle" Text="主题颜色" FontSize="14" FontWeight="SemiBold"/>
                            <!-- 8 行调色目标：目标名 | hex 输入框 | 颜色盘按钮 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotLabel0" Grid.Column="0" Text="面板" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotInput0" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Text="#FF000000" Tag="0" TextChanged="SlotInput_TextChanged"/>
                                <Border x:Name="SlotPick0" Grid.Column="2" Height="24" CornerRadius="4" BorderThickness="1"
                                        Tag="0" Tapped="SlotPick_Tapped">
                                    <TextBlock Text="颜色盘" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotLabel1" Grid.Column="0" Text="边框" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotInput1" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Text="#FF000000" Tag="1" TextChanged="SlotInput_TextChanged"/>
                                <Border x:Name="SlotPick1" Grid.Column="2" Height="24" CornerRadius="4" BorderThickness="1"
                                        Tag="1" Tapped="SlotPick_Tapped">
                                    <TextBlock Text="颜色盘" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotLabel2" Grid.Column="0" Text="按键底" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotInput2" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Text="#FF000000" Tag="2" TextChanged="SlotInput_TextChanged"/>
                                <Border x:Name="SlotPick2" Grid.Column="2" Height="24" CornerRadius="4" BorderThickness="1"
                                        Tag="2" Tapped="SlotPick_Tapped">
                                    <TextBlock Text="颜色盘" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotLabel3" Grid.Column="0" Text="文字" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotInput3" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Text="#FF000000" Tag="3" TextChanged="SlotInput_TextChanged"/>
                                <Border x:Name="SlotPick3" Grid.Column="2" Height="24" CornerRadius="4" BorderThickness="1"
                                        Tag="3" Tapped="SlotPick_Tapped">
                                    <TextBlock Text="颜色盘" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotLabel4" Grid.Column="0" Text="按下底" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotInput4" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
