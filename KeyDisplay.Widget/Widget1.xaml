<Page
    x:Class="KeyDisplay.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="KeyBorder" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootPanel" CornerRadius="10" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <!-- 第一行 Q W E R -->
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="KeyQ" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyQText" Style="{StaticResource KeyText}" Text="Q"/>
                            </Border>
                            <Border x:Name="KeyW" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyWText" Style="{StaticResource KeyText}" Text="W"/>
                            </Border>
                            <Border x:Name="KeyE" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyEText" Style="{StaticResource KeyText}" Text="E"/>
                            </Border>
                            <Border x:Name="KeyR" Width="52" Style="{StaticResource KeyBorder}" Margin="0,0,0,0">
                                <TextBlock x:Name="KeyRText" Style="{StaticResource KeyText}" Text="R"/>
                            </Border>
                        </StackPanel>
                        <!-- 第二行 A S D F -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="KeyA" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyAText" Style="{StaticResource KeyText}" Text="A"/>
                            </Border>
                            <Border x:Name="KeyS" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeySText" Style="{StaticResource KeyText}" Text="S"/>
                            </Border>
                            <Border x:Name="KeyD" Width="52" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyDText" Style="{StaticResource KeyText}" Text="D"/>
                            </Border>
                            <Border x:Name="KeyF" Width="52" Style="{StaticResource KeyBorder}" Margin="0,0,0,0">
                                <TextBlock x:Name="KeyFText" Style="{StaticResource KeyText}" Text="F"/>
                            </Border>
                        </StackPanel>
                        <!-- 第三行 Shift Ctrl Alt -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="KeyShift" Width="68" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyShiftText" Style="{StaticResource KeyText}" FontSize="13" Text="Shift"/>
                            </Border>
                            <Border x:Name="KeyCtrl" Width="68" Style="{StaticResource KeyBorder}">
                                <TextBlock x:Name="KeyCtrlText" Style="{StaticResource KeyText}" FontSize="13" Text="Ctrl"/>
                            </Border>
                            <Border x:Name="KeyAlt" Width="68" Style="{StaticResource KeyBorder}" Margin="0,0,0,0">
                                <TextBlock x:Name="KeyAltText" Style="{StaticResource KeyText}" FontSize="13" Text="Alt"/>
                            </Border>
                        </StackPanel>
                        <!-- 第四行 空格（单独一行，标准键盘式底部空格） -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="KeySpace" Width="176" Style="{StaticResource KeyBorder}" Margin="0,0,0,0">
                                <TextBlock x:Name="KeySpaceText" Style="{StaticResource KeyText}" FontSize="13" Text="空格"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!-- 鼠标区 -->
                    <StackPanel Orientation="Vertical" Margin="16,0,0,0">
                        <Border x:Name="MousePad" Width="80" Height="80" CornerRadius="8" BorderThickness="1">
                            <Canvas x:Name="MousePadCanvas">
                                <Ellipse x:Name="MouseDot" Width="10" Height="10"/>
                            </Canvas>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="MouseL" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock x:Name="MouseLText" Style="{StaticResource KeyText}" FontSize="12" Text="左"/>
                            </Border>
                            <Border x:Name="MouseM" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock x:Name="MouseMText" Style="{StaticResource KeyText}" FontSize="12" Text="中"/>
                            </Border>
                            <Border x:Name="MouseR" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Margin="0,0,0,0">
                                <TextBlock x:Name="MouseRText" Style="{StaticResource KeyText}" FontSize="12" Text="右"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="MouseX1" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock x:Name="MouseX1Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧下"/>
                            </Border>
                            <Border x:Name="MouseX2" Width="36" Height="36" CornerRadius="6" BorderThickness="1" Margin="0,0,0,0">
                                <TextBlock x:Name="MouseX2Text" Style="{StaticResource KeyText}" FontSize="12" Text="侧上"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- 底部主题切换：单一紧凑胶囊按钮，标签显示可切换到的主题，点击即切换 -->
                <Border x:Name="ThemeToggleBtn" Grid.Row="1" Width="44" Height="26" HorizontalAlignment="Right"
                        CornerRadius="13" BorderThickness="1" Margin="0,8,0,0" Tapped="ThemeToggle_Click">
                    <TextBlock x:Name="ThemeToggleBtnText" Text="白" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</Page>