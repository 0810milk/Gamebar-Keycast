                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="左Alt" Tapped="AddKeyFromLayout_Click"><TextBlock Text="左Alt" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="120" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="Space" Tapped="AddKeyFromLayout_Click"><TextBlock Text="空格" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="右Alt" Tapped="AddKeyFromLayout_Click"><TextBlock Text="右Alt" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="右Win" Tapped="AddKeyFromLayout_Click"><TextBlock Text="右Win" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="Menu" Tapped="AddKeyFromLayout_Click"><TextBlock Text="Menu" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="右Ctrl" Tapped="AddKeyFromLayout_Click"><TextBlock Text="右Ctrl" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                    <!-- 编辑区：Ins Del Home End PgUp PgDn -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="Ins" Tapped="AddKeyFromLayout_Click"><TextBlock Text="Ins" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="Del" Tapped="AddKeyFromLayout_Click"><TextBlock Text="Del" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="Home" Tapped="AddKeyFromLayout_Click"><TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="End" Tapped="AddKeyFromLayout_Click"><TextBlock Text="End" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="PgUp" Tapped="AddKeyFromLayout_Click"><TextBlock Text="PgUp" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="PgDn" Tapped="AddKeyFromLayout_Click"><TextBlock Text="PgDn" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                    <!-- 方向键：↑ ↓ ← → -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="↑" Tapped="AddKeyFromLayout_Click"><TextBlock Text="↑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="↓" Tapped="AddKeyFromLayout_Click"><TextBlock Text="↓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="←" Tapped="AddKeyFromLayout_Click"><TextBlock Text="←" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="30" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="→" Tapped="AddKeyFromLayout_Click"><TextBlock Text="→" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                    <!-- 鼠标区：左键 右键 中键 侧上 侧下 滚轮上 滚轮下 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="左键" Tapped="AddKeyFromLayout_Click"><TextBlock Text="左键" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="右键" Tapped="AddKeyFromLayout_Click"><TextBlock Text="右键" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="中键" Tapped="AddKeyFromLayout_Click"><TextBlock Text="中键" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="侧上" Tapped="AddKeyFromLayout_Click"><TextBlock Text="侧上" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="侧下" Tapped="AddKeyFromLayout_Click"><TextBlock Text="侧下" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="滚轮上" Tapped="AddKeyFromLayout_Click"><TextBlock Text="滚轮上" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Border Width="44" Height="26" CornerRadius="4" BorderThickness="1" Margin="2" Tag="滚轮下" Tapped="AddKeyFromLayout_Click"><TextBlock Text="滚轮下" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="LockResetBtn" Height="26" CornerRadius="6" BorderThickness="1"
                                    Margin="0,12,0,0" Tapped="LockReset_Click">
                                <TextBlock x:Name="LockResetText" Text="重置按键布局" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!-- 按键右键菜单覆盖层：右键按键弹出（删除/复制/修改显示名）；点遮罩关闭 -->
                <Grid x:Name="KeyMenuPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Tapped="KeyMenuPanel_Tapped">
                    <Border x:Name="KeyMenu" Width="130" CornerRadius="8" BorderThickness="1" Tapped="KeyMenu_Tapped">
                        <StackPanel x:Name="KeyMenuItems" Padding="6"/>
                    </Border>
                </Grid>
                <!-- 修改显示名覆盖层：右键菜单「修改显示名」弹出；确定/取消/点遮罩关闭 -->
                <Grid x:Name="RenamePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Tapped="RenamePanel_Tapped">
                    <Border x:Name="RenameBox" Width="220" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="KeyMenu_Tapped">
                        <StackPanel Padding="14">
                            <TextBlock x:Name="RenameTitle" Text="修改显示名" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBox x:Name="RenameInput" FontSize="13" Margin="0,12,0,0" MaxLength="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Border x:Name="RenameConfirm" Width="64" Height="26" CornerRadius="6" BorderThickness="1" Tapped="RenameConfirm_Click">
                                    <TextBlock x:Name="RenameConfirmText" Text="确定" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="RenameCancel" Width="64" Height="26" CornerRadius="6" BorderThickness="1" Margin="12,0,0,0" Tapped="RenameCancel_Click">
                                    <TextBlock x:Name="RenameCancelText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 删除确认框覆盖层：右键自定义键弹出；确认/取消/点遮罩关闭 -->
                <Grid x:Name="DeleteConfirmPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="DeleteConfirmPanel_Tapped">
                    <Border x:Name="DeleteConfirmBox" Width="210" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="LockMenu_Tapped">
                        <StackPanel Padding="14">
                            <TextBlock x:Name="DeleteConfirmText" Text="" FontSize="13" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Border x:Name="DeleteConfirmYes" Width="64" Height="26" CornerRadius="6" BorderThickness="1"
                                        Tapped="DeleteConfirmYes_Click">
                                    <TextBlock x:Name="DeleteConfirmYesText" Text="确认" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="DeleteConfirmNo" Width="64" Height="26" CornerRadius="6" BorderThickness="1"
                                        Margin="12,0,0,0" Tapped="DeleteConfirmNo_Click">
                                    <TextBlock x:Name="DeleteConfirmNoText" Text="取消" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 关于面板覆盖层：设置菜单 ⓘ 按钮点击弹出；点遮罩收起（同在 SettingsPanel 覆盖层网格内，层级更高覆盖其上） -->
                <Grid x:Name="AboutPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent"
                      Tapped="AboutPanel_Tapped">
                    <Border x:Name="AboutMenu" Width="240" CornerRadius="8" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,44"
                            Tapped="AboutMenu_Tapped">
                        <StackPanel Padding="16">
                            <TextBlock x:Name="AboutTitle" Text="关于" FontSize="14" FontWeight="SemiBold"/>
                            <!-- 圆形头像：Ellipse + ImageBrush（UniformToFill 裁切为圆形），直径 52 -->
                            <Ellipse x:Name="AboutAvatar" Width="52" Height="52" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="ms-appx:///Assets/Avatar.jpg" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="AboutAuthor" Text="恐龙milk" HorizontalAlignment="Center" FontSize="13" Margin="0,10,0,0"/>
                            <!-- GitHub 行：点击打开浏览器；Game Bar 拦截时自动复制链接（文本可选中复制兜底） -->
                            <Border x:Name="AboutGitHubRow" Margin="0,12,0,0" Tapped="GitHubRow_Tapped" Background="Transparent">
                                <TextBlock x:Name="AboutGitHubText" Text="https://github.com/0810milk/Gamebar-Keycast"
                                           FontSize="11" TextWrapping="Wrap" TextDecorations="Underline" Foreground="#4A9EFF"
                                           IsTextSelectionEnabled="True"/>
                            </Border>
                            <!-- QQ 反馈群行：点击跳群链接（只显示群号文本，链接不显示） -->
                            <Border x:Name="AboutQqRow" Margin="0,8,0,0" Tapped="QqRow_Tapped" Background="Transparent">
                                <TextBlock x:Name="AboutQqText" Text="QQ 反馈群：2152061189"
                                           FontSize="12" TextDecorations="Underline" Foreground="#4A9EFF"
                                           IsTextSelectionEnabled="True"/>
                            </Border>
                            <!-- 复制降级提示：链接被宿主拦截时显示（1.5s） -->
                            <TextBlock x:Name="AboutCopyTip" Text="链接已复制，请在浏览器粘贴打开"
                                       FontSize="11" Foreground="#4A9EFF" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- 吸附参考线层：吸附发生时显示浅蓝虚线；置于所有按键之上、不拦截指针，不参与吸附计算 -->
        <Canvas x:Name="SnapCanvas" IsHitTestVisible="False"/>
    </Grid>
</Page>